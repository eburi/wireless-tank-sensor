# Copy to secrets.yaml (gitignored) and fill in real values.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
ota_password: "choose-an-ota-password"
# One key shared by the whole fleet (HA asks for it when adding each device):
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "base64-32-bytes"
